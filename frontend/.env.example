# Example Vite environment file for the frontend
# Copy to .env and fill values when running locally or in CI.

# Enable to bypass auth during local development (do not enable in production)
VITE_DEV_BYPASS_AUTH=true

# RPC endpoint used by smart account / bundler (redact your API key)
# e.g. https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>
VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>

# Hex chain id (0x-prefixed). Example: Sepolia = 0xaa36a7
VITE_CHAIN_ID=0xaa36a7

# Web3Auth configuration
VITE_WEB3AUTH_CLIENT_ID=<WEB3AUTH_CLIENT_ID>
VITE_WEB3AUTH_NETWORK=sapphire_devnet

# Bundler / paymaster URL (if used)
VITE_BUNDLER_URL=https://<bundler-endpoint.example>

# Backend API base URL
VITE_API_BASE_URL=http://localhost:4000
