# Example environment variables for contracts (Hardhat) tasks
# Copy this file to .env and fill values before running deploy scripts.

# RPC endpoint used by networks in hardhat.config.js
# e.g. Sepolia: https://eth-sepolia.g.alchemy.com/v2/<KEY>
SEPOLIA_RPC_URL=

# Private key used for deployment (0x-prefixed or not). Either set PRIVATE_KEY
# or BACKEND_SIGNER_PRIVATE_KEY. NEVER commit real private keys to source.
PRIVATE_KEY=
BACKEND_SIGNER_PRIVATE_KEY=

# Number of block confirmations to wait for on deploy/wiring (optional)
DEPLOY_CONFIRMATIONS=1

# Default royalty basis points for marketplace deploy (optional)
# (e.g. 500 = 5.00%)
ROYALTY_BPS=500

# After successful deploy scripts will write these addresses into .env / backend/.env
# You can seed them here to skip redeploying or to wire existing contracts.
TICKET_ADDRESS=
FUND_ADDRESS=
MARKETPLACE_ADDRESS=

# Local path where contract artifacts are written/expected by other services
CONTRACTS_ARTIFACTS_DIR=./artifacts

# Notes:
# - Use `npm run deploy:sepolia` or `npx hardhat run contracts/scripts/deployAll.js --network sepolia`
# - Keep private keys secret; use environment variables provided by CI when running in automation.
