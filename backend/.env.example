# Example backend .env for local development and CI.
# Copy this to .env and fill in real values. DO NOT commit real secrets.

PORT=4000
NODE_ENV=Dev

# MongoDB URIs
MONGO_DEV_URI=mongodb+srv://<user>:<password>@cluster.example.mongodb.net/eventfund
MONGO_PROD_URI=mongodb+srv://<user>:<password>@cluster.example.mongodb.net/eventfund-prod

# Cloudinary (image storage)
CLOUDINARY_DEV_NAME=<cloudinary_dev_name>
CLOUDINARY_DEV_KEY=<cloudinary_dev_key>
CLOUDINARY_DEV_SECRET=<cloudinary_dev_secret>

CLOUDINARY_PROD_NAME=<cloudinary_prod_name>
CLOUDINARY_PROD_KEY=<cloudinary_prod_key>
CLOUDINARY_PROD_SECRET=<cloudinary_prod_secret>

# JWT for backend sessions
JWT_SECRET=<jwt_secret>
JWT_EXPIRES_IN=7d

# SIWE (Sign-In With Ethereum) config
SIWE_DOMAIN=localhost
SIWE_URI=https://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
SIWE_CHAIN_ID=1

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info

# Web3Auth Account Abstraction
WEB3AUTH_CLIENT_ID=<web3auth_client_id>
WEB3AUTH_NETWORK=sapphire_devnet
WEB3AUTH_AUTH_CONNECTION_ID=funding

# Pimlico (Account Abstraction)
PIMLICO_API_KEY=<pimlico_api_key>
PIMLICO_BUNDLER_URL_BASE=https://api.pimlico.io/v2
PIMLICO_PAYMASTER_URL_BASE=https://api.pimlico.io/v2
PIMLICO_SPONSORSHIP_POLICY_ID=<pimlico_policy_id>

# Blockchain RPC URLs
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/<key>
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>

# JWT key files for Web3Auth (paths relative to backend)
JWT_PRIVATE_KEY_PATH=./keys/jwt-private-key.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public-key.pem
JWT_KEY_ID=<jwt_key_id>

# RPC URL used by some scripts (e.g. relayer)
RPC_URL=https://ethereum-sepolia.publicnode.com

# Private keys (use CI secrets, not checked-in files)
BACKEND_SIGNER_PRIVATE_KEY=<0x_or_plain_private_key>

# EIP-712 delegated signature settings
DELEGATED_SIG_CHAIN_ID=11155111
DELEGATED_SIG_DOMAIN_NAME=EventFund Relayer
DELEGATED_SIG_DOMAIN_VERSION=1

# Signature enforcement flags
RELAYER_REQUIRE_CREATE_EVENT_SIGNATURE=false
RELAYER_REQUIRE_ADMIN_STATUS_SIGNATURE=false

# Contracts artifacts & addresses (populated by deploy scripts)
CONTRACTS_ARTIFACTS_DIR=../contracts/artifacts
TICKET_ADDRESS=
FUND_ADDRESS=
MARKETPLACE_ADDRESS=

CHAIN_LOG_CHUNK_SIZE=5

# Auto event lifecycle (optional)
AUTO_EVENT_LIFECYCLE_ENABLED=true
AUTO_EVENT_LIFECYCLE_INTERVAL_MS=30000
AUTO_EVENT_LIFECYCLE_SCAN_LIMIT=50
AUTO_TICKETING_DEFAULT_TYPE=0

#############################################
# VNPay (VND -> ETH deposits)
#############################################
VNPAY_URL=https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=<vnpay_tmn_code>
VNPAY_HASH_SECRET=<vnpay_hash_secret>
VNPAY_RETURN_URL=https://your-frontend.example.com/api/deposits/vnpay-return
VNPAY_IPN_URL=https://your-backend.example.com/api/deposits/vnpay-ipn

#############################################
# Relayer wallet (for sending ETH after VND payment)
#############################################
# WARNING: keep secret; use CI or secrets manager
RELAYER_PRIVATE_KEY=<0x_or_plain_private_key>

#############################################
# Frontend
#############################################
FRONTEND_URL=http://localhost:5173

#############################################
# Deposit limits
#############################################
MIN_DEPOSIT_VND=10000
MAX_DEPOSIT_VND=50000000
DEPOSIT_ORDER_EXPIRY_MINUTES=15
#############################################
# Server Configuration
#############################################
PORT=4000
NODE_ENV=Dev

#############################################
# MongoDB
#############################################
MONGO_PROD_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?appName=<app-name>
MONGO_PROD_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?appName=<app-name>

#############################################
# Cloudinary (Image Upload)
#############################################
CLOUDINARY_PROD_NAM=your_dev_cloudinary_name
CLOUDINARY_PROD_KEY=your_dev_cloudinary_key
CLOUDINARY_PROD_SECRET=your_dev_cloudinary_secret

CLOUDINARY_PROD_NAME=your_prod_cloudinary_name
CLOUDINARY_PROD_KEY=your_prod_cloudinary_key
CLOUDINARY_PROD_SECRET=your_prod_cloudinary_secret

#############################################
# JWT Configuration
#############################################
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
JWT_PRIVATE_KEY_PATH=./keys/jwt-private-key.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public-key.pem
JWT_KEY_ID=your_jwt_key_id

#############################################
# SIWE (Sign-In with Ethereum)
#############################################
SIWE_DOMAIN=localhost:4000
SIWE_URI=http://localhost:4000
SIWE_CHAIN_ID=1

#############################################
# CORS Configuration
#############################################
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

#############################################
# Rate Limiting
#############################################
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

#############################################
# Redis Cloud Configuration
#############################################
# Redis Cloud host (from Redis Cloud Console)

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_TLS=false
#############################################
# Logging
#############################################
LOG_LEVEL=info

#############################################
# Web3Auth Account Abstraction
#############################################
WEB3AUTH_CLIENT_ID=your_web3auth_client_id
WEB3AUTH_NETWORK=sapphire_devnet
WEB3AUTH_AUTH_CONNECTION_ID=funding

#############################################
# Pimlico Configuration (Account Abstraction)
#############################################
PIMLICO_API_KEY=your_pimlico_api_key
PIMLICO_BUNDLER_URL_BASE=https://api.pimlico.io/v2
PIMLICO_PAYMASTER_URL_BASE=https://api.pimlico.io/v2
PIMLICO_SPONSORSHIP_POLICY_ID=your_sponsorship_policy_id

#############################################
# Blockchain RPC URLs
#############################################
RPC_URL=https://ethereum-sepolia.publicnode.com
ETHEREUM_RPC_URL=https://eth.llamarpc.com
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-api-key>

#############################################
# Backend Signer & EIP-712 Configuration
#############################################
BACKEND_SIGNER_PRIVATE_KEY=0x<your_private_key>
DELEGATED_SIG_CHAIN_ID=11155111
DELEGATED_SIG_DOMAIN_NAME=EventFund Relayer
DELEGATED_SIG_DOMAIN_VERSION=1

#############################################
# Signature Enforcement Flags
#############################################
RELAYER_REQUIRE_CREATE_EVENT_SIGNATURE=false
RELAYER_REQUIRE_ADMIN_STATUS_SIGNATURE=false

#############################################
# Smart Contract Addresses
#############################################
TICKET_ADDRESS=0x<your_ticket_contract_address>
FUND_ADDRESS=0x<your_fund_contract_address>
MARKETPLACE_ADDRESS=0x<your_marketplace_contract_address>

#############################################
# Contract Artifacts
#############################################
CONTRACTS_ARTIFACTS_DIR=../contracts/artifacts

#############################################
# Blockchain Indexing Configuration
#############################################
CHAIN_LOG_CHUNK_SIZE=5

#############################################
# Auto Event Lifecycle
#############################################
AUTO_EVENT_LIFECYCLE_ENABLED=true
AUTO_EVENT_LIFECYCLE_INTERVAL_MS=30000
AUTO_EVENT_LIFECYCLE_SCAN_LIMIT=50
AUTO_TICKETING_DEFAULT_TYPE=0

#############################################
# VNPay Configuration (VND to ETH deposits)
#############################################
# VNPay Gateway URL
# Sandbox: https://sandbox.vnpayment.vn
# Production: https://vnpayment.vn
VNPAY_URL=https://sandbox.vnpayment.vn

# VNPay Terminal Code (TMN Code)
VNPAY_TMN_CODE=your_vnpay_tmn_code

# VNPay Hash Secret (for signature verification)
VNPAY_HASH_SECRET=your_vnpay_hash_secret

# VNPay Return URL (where user is redirected after payment)
VNPAY_RETURN_URL=http://localhost:4000/api/deposits/vnpay-return

# VNPay IPN URL (webhook for payment notification)
# Must be publicly accessible (use ngrok for local testing)
VNPAY_IPN_URL=https://your-domain.com/api/deposits/vnpay-ipn

#############################################
# Relayer Wallet (for sending ETH to users)
#############################################
# Private key of the relayer wallet (must have ETH balance)
RELAYER_PRIVATE_KEY=0x<your_relayer_private_key>

#############################################
# Frontend Configuration
#############################################
# Frontend URL (for redirects after payment)
FRONTEND_URL=http://localhost:5173

#############################################
# Deposit Limits
#############################################
# Minimum deposit amount in VND
MIN_DEPOSIT_VND=10000

# Maximum deposit amount in VND
MAX_DEPOSIT_VND=50000000

# Order expiry time in minutes
DEPOSIT_ORDER_EXPIRY_MINUTES=15

#############################################
# Exchange Rate Configuration
#############################################
# CoinMarketCap API Key (RECOMMENDED - Primary source)
# Get free API key at: https://coinmarketcap.com/api/
# Free tier: 10,000 calls/month, 333 calls/day
COINMARKETCAP_API_KEY=fc154e52a8524c62960b87b1a84230f0

# Exchange rate cache TTL in milliseconds (default: 5 minutes)
EXCHANGE_RATE_CACHE_TTL=300000

# Fallback cache max age in milliseconds (default: 24 hours)
EXCHANGE_RATE_FALLBACK_MAX_AGE=86400000
