PORT=4000
NODE_ENV=Dev

MONGO_DEV_URI=mongodb+srv://
MONGO_PROD_URI=mongodb+srv://

CLOUDINARY_DEV_NAME=
CLOUDINARY_DEV_KEY=
CLOUDINARY_DEV_SECRET=

CLOUDINARY_PROD_NAME=
CLOUDINARY_PROD_KEY=
CLOUDINARY_PROD_SECRET=

JWT_SECRET=secret
JWT_EXPIRES_IN=7d

SIWE_DOMAIN=localhost:4000
SIWE_URI=http://localhost:4000
SIWE_CHAIN_ID=1

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info