#############################################
# Backend runtime
#############################################

# Express server port
PORT=4000

# NOTE: code checks NODE_ENV === 'PROD' to decide prod DB URI.
# Any other value uses MONGO_DEV_URI.
NODE_ENV=DEV

#############################################
# MongoDB
#############################################

# Dev/local database connection string
MONGO_DEV_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

# Production database connection string (used only when NODE_ENV=PROD)
MONGO_PROD_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

#############################################
# Cloudinary (optional - only needed if you upload images)
#############################################

# Cloudinary Configuration
# Base credentials (fallback if environment-specific not set)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Development environment credentials
CLOUDINARY_DEV_NAME=
CLOUDINARY_DEV_KEY=
CLOUDINARY_DEV_SECRET=

# Production environment credentials
CLOUDINARY_PROD_NAME=
CLOUDINARY_PROD_KEY=
CLOUDINARY_PROD_SECRET=

# Optional Cloudinary settings
CLOUDINARY_UPLOAD_FOLDER=uploads
MAX_IMAGE_SIZE_MB=5
MAX_EVENT_IMAGES=10

JWT_SECRET=secret
JWT_EXPIRES_IN=7d

SIWE_DOMAIN=localhost:4000
SIWE_URI=http://localhost:4000
SIWE_CHAIN_ID=1

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
CLOUDINARY_PROD_NAME=your_prod_cloudinary_name
CLOUDINARY_PROD_KEY=your_prod_cloudinary_key
CLOUDINARY_PROD_SECRET=your_prod_cloudinary_secret

#############################################
# Blockchain RPC (ethers v6 JsonRpcProvider)
#############################################

# Local Hardhat node example: http://127.0.0.1:8545
# Sepolia example: https://sepolia.infura.io/v3/<key>
RPC_URL=http://127.0.0.1:8545

#############################################
# Deployed contract addresses (NO leading/trailing spaces)
#############################################

# Get from Hardhat deployment output (local/testnet)
TICKET_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
FUND_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
MARKETPLACE_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

#############################################
# Chain sync & reorg policy (used by indexers/processors)
#############################################

# How many confirmations before a block is considered safe
CHAIN_CONFIRMATIONS=12

# How many blocks to rewind and rescan each loop (reorg safety)
REORG_BUFFER_BLOCKS=12

# Log fetch chunk size (fromBlock..toBlock per RPC call)
CHAIN_LOG_CHUNK_SIZE=2000

# Indexer polling interval (ms)
CHAIN_SYNC_INTERVAL_MS=10000

# Processor polling interval (ms). If empty, falls back to CHAIN_SYNC_INTERVAL_MS.
CHAIN_PROCESS_INTERVAL_MS=10000

#############################################
# Per-contract start blocks (optional but recommended for testnet)
#############################################

# Block number where each contract was deployed (or where you want to start indexing)
TICKET_START_BLOCK=0
FUND_START_BLOCK=0
MARKETPLACE_START_BLOCK=0

# Ticket derived-event processor start block (defaults to TICKET_START_BLOCK)
TICKET_PROCESSOR_START_BLOCK=0
